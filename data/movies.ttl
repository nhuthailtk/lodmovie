@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/moviekg/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://example.org/moviekg/resource/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:label "Movie Genre Knowledge Graph"@en ;
    rdfs:comment "A course ontology for IMDb movie datasets. Genres are individuals, not movie subclasses. Missing facts remain unknown."@en .

ex:averageRating a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:decimal .

ex:birthYear a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:integer .

ex:characterName a owl:DatatypeProperty ;
    rdfs:domain ex:PrincipalCredit ;
    rdfs:range xsd:string .

ex:creditCategory a owl:DatatypeProperty ;
    rdfs:comment "A person's job category such as actor or producer; not a movie genre."@en ;
    rdfs:domain ex:PrincipalCredit ;
    rdfs:range xsd:string .

ex:creditOrder a owl:DatatypeProperty ;
    rdfs:domain ex:PrincipalCredit ;
    rdfs:range xsd:integer .

ex:creditedPerson a owl:ObjectProperty ;
    rdfs:domain ex:PrincipalCredit ;
    rdfs:range ex:Person .

ex:deathYear a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:integer .

ex:directedBy a owl:ObjectProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:Person ;
    owl:inverseOf ex:directorOf .

ex:endYear a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:integer .

ex:hasActor a owl:ObjectProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:Person ;
    owl:inverseOf ex:actedIn .

ex:hasCredit a owl:ObjectProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:PrincipalCredit .

ex:hasTitleVariant a owl:ObjectProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:TitleVariant .

ex:imdbId a owl:DatatypeProperty ;
    rdfs:range xsd:string .

ex:isAdult a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:boolean .

ex:isOriginalTitle a owl:DatatypeProperty ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:boolean .

ex:job a owl:DatatypeProperty ;
    rdfs:domain ex:PrincipalCredit ;
    rdfs:range xsd:string .

ex:knownForTitlePage a owl:ObjectProperty ;
    rdfs:comment "IMDb webpage for a known-for title, which need not be a movie or be in the selected sample."@en ;
    rdfs:domain ex:Person .

ex:nameRecordMissing a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:boolean .

ex:numVotes a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:integer .

ex:originalTitle a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:string .

ex:primaryName a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string .

ex:primaryProfession a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string .

ex:primaryTitle a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:string .

ex:releaseYear a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:integer .

ex:retrievedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ex:runtimeMinutes a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:integer .

ex:sampledForGenre a owl:ObjectProperty ;
    rdfs:comment "Genre quota for which this movie was randomly sampled."@en ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:Genre ;
    rdfs:subPropertyOf ex:hasGenre .

ex:sha256 a owl:DatatypeProperty ;
    rdfs:range xsd:string .

ex:titleLanguage a owl:DatatypeProperty ;
    rdfs:comment "Language associated with this title variant; NOT spoken language of the movie."@en ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:string .

ex:titleRegion a owl:DatatypeProperty ;
    rdfs:comment "Region associated with this title variant; NOT country of production."@en ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:string .

ex:titleType a owl:DatatypeProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range xsd:string .

ex:variantAttribute a owl:DatatypeProperty ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:string .

ex:variantOrder a owl:DatatypeProperty ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:integer .

ex:variantTitle a owl:DatatypeProperty ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:string .

ex:variantType a owl:DatatypeProperty ;
    rdfs:domain ex:TitleVariant ;
    rdfs:range xsd:string .

ex:writtenBy a owl:ObjectProperty ;
    rdfs:domain ex:Movie ;
    rdfs:range ex:Person ;
    owl:inverseOf ex:writerOf .

